# Modelo de configuração. Copie para .env e preencha com os valores do seu ambiente.
# O arquivo .env NUNCA deve ser versionado.

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/epi_db?schema=public"

# Conexão usada pelas MIGRAÇÕES. Em banco local é igual à DATABASE_URL.
DIRECT_URL="postgresql://USUARIO:SENHA@localhost:5432/epi_db?schema=public"

# No Supabase as duas são diferentes: a aplicação vai pelo pooler (6543), que não
# aceita os comandos DDL das migrações, e o migrate vai pela conexão direta (5432).
#   DATABASE_URL="postgresql://postgres.<ref>:<senha>@<host>:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.<ref>:<senha>@<host>:5432/postgres"

# Chaves de assinatura dos tokens. Em produção, gere valores longos e aleatórios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="troque-por-um-valor-aleatorio-longo"
JWT_REFRESH_SECRET="troque-por-outro-valor-aleatorio-longo"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000

# Endereço do frontend. Em produção, use o domínio real (https://epi.suaempresa.com.br)
CORS_ORIGIN="http://localhost:5173"

# Pasta do frontend já compilado, servida por esta mesma aplicação.
# Vazio em desenvolvimento: o Vite serve o site em :5173 e repassa /api para cá.
# Em produção use "../web/dist" (caminho relativo a apps/api). Servir o site aqui
# mantém site e API na MESMA origem, porque o cookie de refresh é SameSite=Lax e
# o navegador não o envia entre domínios diferentes — em domínios separados o
# acesso cairia a cada expiração do token.
SERVE_WEB_DIR=""

# ----- Armazenamento dos arquivos (fotos de confirmação, notas fiscais, logo) -----
# "local"    grava em disco. Use em desenvolvimento.
# "supabase" grava no Supabase Storage. OBRIGATÓRIO em hospedagem gratuita:
#            lá o disco é apagado a cada reinício ou deploy, e perder a foto da
#            confirmação significa perder a prova da entrega do EPI.
STORAGE_DRIVER="local"

# Pasta usada quando STORAGE_DRIVER="local".
UPLOAD_DIR="./uploads"

# Usados quando STORAGE_DRIVER="supabase". A service key tem acesso total ao
# projeto: ela fica apenas no servidor, nunca no frontend.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="epi-arquivos"

# "development" expõe o token de recuperação de senha na resposta da API
# para permitir testes sem servidor de e-mail. Em produção use "production".
NODE_ENV="development"
