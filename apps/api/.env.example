# Modelo de configuração. Copie para .env e preencha com os valores do seu ambiente.
# O arquivo .env NUNCA deve ser versionado.

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/epi_db?schema=public"

# Chaves de assinatura dos tokens. Em produção, gere valores longos e aleatórios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="troque-por-um-valor-aleatorio-longo"
JWT_REFRESH_SECRET="troque-por-outro-valor-aleatorio-longo"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000

# Endereço do frontend. Em produção, use o domínio real (https://epi.suaempresa.com.br)
CORS_ORIGIN="http://localhost:5173"

# Pasta dos arquivos enviados (fotos de confirmação, notas fiscais, logo).
# Em produção aponte para um disco permanente.
UPLOAD_DIR="./uploads"

# "development" expõe o token de recuperação de senha na resposta da API
# para permitir testes sem servidor de e-mail. Em produção use "production".
NODE_ENV="development"
